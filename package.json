{
  "name": "premium-discord-bot",
  "version": "2.0.4",
  "description": "Production-grade TypeScript Discord bot with moderation, automod, anti-raid/anti-nuke security, dashboard, and health monitoring",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-dashboard.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run build && node -e \"require('fs').accessSync('dist/index.js'); require('fs').accessSync('dist/dashboard/index.html'); console.log('Build verification passed.')\"",
    "start": "npm run deploy-commands && node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "deploy-commands": "node dist/deploy-commands.js",
    "start:production": "npm run build && npm start",
    "postinstall": "npm rebuild better-sqlite3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "discord.js": "14.11.0",
    "dotenv": "16.1.4",
    "express": "4.18.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "4.17.17",
    "@types/node": "20.4.2",
    "ts-node": "10.9.1",
    "ts-node-dev": "2.0.0",
    "typescript": "5.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
