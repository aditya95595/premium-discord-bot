{
  "name": "ts-discord-bot-complete",
  "version": "1.0.0",
  "description": "A complete TypeScript Discord bot with moderation, automod, anti-raid/anti-nuke, and health server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "deploy-commands": "node dist/deploy-commands.js || ts-node src/deploy-commands.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^8.0.1",
    "discord.js": "^14.11.0",
    "dotenv": "^16.1.4",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
