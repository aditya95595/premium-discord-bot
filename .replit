# Production Replit configuration: Discord bot + Express web dashboard.
# The dashboard is a WEB SERVER, not a Canvas app.
# Replit Secrets must contain credentials; never put secrets here.

entrypoint = "src/index.ts"
run = "npm run start:production"

[deployment]
run = ["npm", "run", "start:production"]

[env]
NODE_ENV = "production"
PORT = "3000"
