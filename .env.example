# Discord bot
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id
OWNER_ID=your-discord-user-id
# Optional dev guild for instant slash-command registration
GUILD_ID=your-dev-guild-id

# SQLite
DB_PATH=./data/bot.sqlite

# HTTP server
PORT=3000

# Dashboard Discord OAuth2
DISCORD_CLIENT_SECRET=your-oauth-client-secret
# Optional in Replit; set this to the exact public callback URL when using a custom domain.
DISCORD_REDIRECT_URI=https://your-domain.example/auth/callback
# Optional in Replit; exact public HTTPS origin. If omitted, the bot derives it from forwarded headers.
DASHBOARD_PUBLIC_URL=https://your-domain.example
# Long random secret (at least 32 bytes of entropy) used to encrypt sessions.
SESSION_SECRET=replace-with-a-long-random-secret
# Optional path override if the dashboard is mounted outside the repository root.
DASHBOARD_PATH=./dashboard
