# Discord bot
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
OWNER_ID=your-discord-user-id
# Optional dev guild for fast command registration
GUILD_ID=your-dev-guild-id

# SQLite
DB_PATH=./data/bot.sqlite

# Replit HTTP server
PORT=3000

# Dashboard Discord OAuth2
DISCORD_CLIENT_SECRET=your-oauth-client-secret
# If omitted, the dashboard derives https://YOUR-REPLIT-DOMAIN/auth/callback
DISCORD_REDIRECT_URI=
# Public dashboard origin, optional when behind a proxy
DASHBOARD_PUBLIC_URL=
# Long random secret used to encrypt HttpOnly dashboard sessions
SESSION_SECRET=replace-with-a-long-random-secret
