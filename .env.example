# Discord bot
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id
OWNER_ID=your-discord-user-id
# Optional dev guild for fast command registration
GUILD_ID=your-dev-guild-id

# Clash of Clans API
# Get a production API token from the official Clash of Clans developer portal.
COC_API_TOKEN=your-clash-of-clans-api-token
# Optional fallback clan tag used by /coc commands when no tag is supplied.
COC_DEFAULT_CLAN_TAG=#YOURCLAN

# SQLite
DB_PATH=./data/bot.sqlite

# HTTP server
PORT=3000

# Dashboard Discord OAuth2
DISCORD_CLIENT_SECRET=your-oauth-client-secret
# Explicit callback is recommended in production.
DISCORD_REDIRECT_URI=https://your-domain.example/auth/callback
# Public dashboard origin. Must be the exact HTTPS origin in production.
DASHBOARD_PUBLIC_URL=https://your-domain.example
# Long random secret (at least 32 bytes of entropy) used to encrypt sessions.
SESSION_SECRET=replace-with-a-long-random-secret
